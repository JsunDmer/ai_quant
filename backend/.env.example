# Stock MVP 环境配置示例
# 复制此文件为 .env 并填入实际值

# DeepSeek API 配置 (必填)
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 钉钉 Webhook (可选，用于报警推送)
DINGDING_WEBHOOK=

# 数据库路径 (可选，默认 backend.db；相对路径相对于 backend/ 目录，不因启动目录变化)
DB_PATH=backend.db
